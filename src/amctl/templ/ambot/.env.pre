# NoneBot setting
# Which environment to run in (.env choices)
# e.g. ENVIRONMENT=prod, the `.env.prod` will be used;
# e.g. ENVIRONMENT=dev, the `.env.dev` will be used;
# The environment variable in .env.* will override the value in .env
ENVIRONMENT=dev
# Keep the same as the driver, amrita will automatically select the driver.
# If you DON'T know what you are doing, please leave it commented.
#DRIVER=~fastapi
# Which address:port to listen to
# HINT: Please do not to make this address public, which may make your bot instance under attacking.
HOST=127.0.0.1
PORT=8080
# Recommended to set to ensure the security of the Bot Account
#ONEBOT_ACCESS_TOKEN=My-Safe-Token
# Whether to set the localstore to use the current working directory, recommended to set it to true.
# If you don't know what you are doing, please leave it commented.
# See https://github.com/nonebot/plugin-localstore/blob/master/README.md for more helps.
LOCALSTORE_USE_CWD=true
# Command separator
# This option separating command and args.
# e.g. COMMAND_SEP=[" "], execute: `/command a`, command: `command`, args: `a`
COMMAND_SEP=[".", " ",""]

# Alembic setting. When enabled, will check the structure of the database and update it if necessary when startup.
ALEMBIC_STARTUP_CHECK=true

# Admin-Group ID, bot will push logs to this group
#ADMIN_GROUP=123456
# The name of the bot to be displayed in the log
#BOT_NAME=OhMyAmrita
# The sender should wait for THIS seconds to send another message
RATE_LIMIT=5

# Superusers
# e.g. SUPERUSERS=["1234567890", "9876543210"]
SUPERUSERS=[]


# WebUI settings
# Password must be set before using WebUI
#WEBUI_PASSWORD=admin123 # Must be changed to a strong password

# Optional settings for SQLAlchemy
#SQLALCHEMY_ENGINE_OPTIONS='{
#    "pool_size": 20,
#    "max_overflow": 20,
#    "pool_timeout": 30,
#    "pool_recycle": 1800,
#    "echo": false
#}'

# Embedding settings for plugin-memory.
#EMBEDDING_MODEL_URL=http://127.0.0.1:11434/
#EMBEDDING_MODEL_NAME="Yes-My-Model"
#EMBEDDING_PROCTOL=ollama-embed